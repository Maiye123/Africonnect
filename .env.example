# API server port
PORT=3001

# Email (SMTP) — required to send real emails
# Gmail example: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Africonnect" <your.email@gmail.com>

# Frontend URL for password-reset links in emails
APP_URL=http://localhost:5173

# Without SMTP settings, codes and reset links are printed in the server terminal (dev only).
